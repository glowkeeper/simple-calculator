{
  "name": "simple-calculator",
  "author": "Dr Steve Huckle <steve.huckle@gmail.com> (https://glowkeeper.github.io/)",
  "homepage": "https://glowkeeper.github.io/simple-calculator",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "scripts": {
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "start": "vite",
    "build": "vite build",
    "test": "npm run test:unit && npm run test:ui",
    "test:unit": "jasmine",
    "test:ui": "vitest run"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "gh-pages": "^6.3.0",
    "jasmine": "^7.0.0",
    "jsdom": "^29.1.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
